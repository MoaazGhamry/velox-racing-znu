# ==============================================================================
# VELOX RACING TEAM — AUTOMATED DECISION EMAIL CONFIGURATION
# ==============================================================================
# To enable fully headless backend email dispatch through Google's SMTP servers,
# generate an App Password from the official VELOX Gmail account:
#
# 1. Sign in to https://myaccount.google.com with velox.racing.znu@gmail.com
# 2. Go to "Security" -> "2-Step Verification" (ensure it is ON)
# 3. Scroll to "App passwords" (or visit https://myaccount.google.com/apppasswords)
# 4. Create an app named "VELOX Web Portal"
# 5. Copy the generated 16-character password and paste below:

SMTP_EMAIL=velox.racing.znu@gmail.com
SMTP_PASSWORD=your_16_char_google_app_password

# Note: Even without an SMTP password configured, HR administrators can
# immediately send official decision emails via the 1-click "Send via Gmail App"
# button on the HR dashboard (hr.html), which pre-fills the candidate's email,
# subject, and formatted onboarding invitation pass directly in the Gmail app.
