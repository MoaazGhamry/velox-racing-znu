{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/upload-photo", "destination": "/api/upload_photo" },
    { "source": "/api/reset-password", "destination": "/api/reset_password" },
    { "source": "/team", "destination": "/team.html" },
    { "source": "/join", "destination": "/join.html" },
    { "source": "/hr", "destination": "/hr.html" },
    { "source": "/portal", "destination": "/portal.html" },
    { "source": "/sponsorship", "destination": "/sponsorship.html" },
    { "source": "/sponsors", "destination": "/sponsorship.html" }
  ]
}
